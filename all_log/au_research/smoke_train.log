Definition simpl (e : PExpr) : PExpr
Definition unfold (t : F(later (mu F))) : mu F := eq_rect _ (id(A:=Type)) t _ (eq_sym eqmu).
Definition now (P: T->Prop) (s: infseq T) : Prop := match s with Cons x s => P x end.
