Definition f0 := (d_ dot).
Fixpoint rewrite (x: regex): regex := match x with | dot x y => cleaning_dot (rewrite x) (rewrite y) | plus x y => cleaning_plus (rewrite x) (rewrite y) | star x => cleaning_star (rewrite x) | x => x end.
Definition simpl (e : PExpr) : PExpr
Definition unfold (t : F(later (mu F))) : mu F := eq_rect _ (id(A:=Type)) t _ (eq_sym eqmu).
Definition now (P: T->Prop) (s: infseq T) : Prop := match s with Cons x s => P x end.
Fixpoint f1 (e : PExpr) : PExpr
Fixpoint f2 (p : PExpr) (e : env) (n : pos) {struct p} : list_res
Definition f3 : env := nil.
Definition f4 : pos := 1%positive.
Definition f5 (p : PExpr) (e : env) := fst (make_PExpr_aux p e f4).
Definition f6 (init_e : env) (s : system) : env
Definition f7 (e : list_res) := match e with ((_, e), _) => e end.
