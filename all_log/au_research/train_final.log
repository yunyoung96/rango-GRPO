[PREMISES]
Lemma nat_iter_S n {A} (f:A->A) i : Nat.iter (S n) f i = f (Nat.iter n f i).
Lemma Nadd_alt n m : n + m = Nat.iter (N.to_nat n) N.succ m.
Lemma nat_iter_0 {A} (f:A->A) i : Nat.iter 0 f i = i.
Lemma Nadd_simpl n p q : Npos (Nadd n (p * q)) = n + Npos p * Npos q.
Lemma of_to (p:positive) : Pos.of_uint (Pos.to_uint p) = Npos p.
Lemma double_succ d : Little.double (Little.succ d) = Little.succ (Little.succ_double d).
Lemma of_uint_acc_eqn d acc : d<>Nil -> Pos.of_uint_acc d acc = Pos.of_uint_acc (tl d) (Nadd (hd d) (10*acc)).
Lemma succ_double_alt d : Little.succ_double d = Little.succ (Little.double d).
Lemma of_lu_0 d : of_lu d = 0 <-> nztail d = Nil.
Lemma of_uint_acc_rev d acc : Npos (Pos.of_uint_acc d acc) = of_lu (rev d) + (Npos acc) * 10^usize d.
Fixpoint of_lu (d:uint) : N := match d with | Nil => 0 | D0 d => 10 * of_lu d | D1 d => 1 + 10 * of_lu d | D2 d => 2 + 10 * of_lu d | D3 d => 3 + 10 * of_lu d | D4 d => 4 + 10 * of_lu d | D5 d => 5 + 10 * of_lu d | D6 d => 6 + 10 * of_lu d | D7 d => 7 + 10 * of_lu d | D8 d => 8 + 10 * of_lu d | D9 d => 9 + 10 * of_lu d end.
Definition to_lu n := match n with | N0 => Decimal.zero | Npos p => Pos.to_little_uint p end.
Lemma of_lu_rev d : Pos.of_uint (rev d) = of_lu d.
Lemma of_uint_alt d : Pos.of_uint d = of_lu (rev d).
Lemma of_lu_revapp d f0 : of_lu (revapp d f0) = of_lu (rev d) + of_lu f0 * 10^usize d.
Lemma of_lu_eqn d : of_lu d = hd d + 10 * (of_lu (tl d)).
Lemma of_lu_succ_double d : of_lu (Little.succ_double d) = N.succ_double (of_lu d).
Lemma of_lu_double d : of_lu (Little.double d) = N.double (of_lu d).
Lemma of_lu_double_gen d : of_lu (Little.double d) = N.double (of_lu d) /\ of_lu (Little.succ_double d) = N.succ_double (of_lu d).
Lemma to_ldec_tenfold p : to_lu (10 * Npos p) = D0 (to_lu (Npos p)).
Lemma to_lu_succ n : to_lu (N.succ n) = Little.succ (to_lu n).
Lemma to_of_lu_tenfold d : to_lu (of_lu d) = lnorm d -> to_lu (10 * of_lu d) = lnorm (D0 d).
[PROOFS]
Lemma of_lu_rev d : Pos.of_uint (rev d) = of_lu d.
Proof.
 rewrite of_uint_alt. now rewrite rev_rev.
Qed.
Lemma to_lu_succ n : to_lu (N.succ n) = Little.succ (to_lu n).
Proof.
 destruct n; simpl; trivial.
 induction p; simpl; rewrite ?IHp;
  auto using succ_double_alt, double_succ.
Qed.
Lemma to_of_lu_tenfold d : to_lu (of_lu d) = lnorm d -> to_lu (10 * of_lu d) = lnorm (D0 d).
Proof.
 intro IH.
 destruct (N.eq_dec (of_lu d) 0) as [H|H].
 - rewrite H. simpl. rewrite of_lu_0 in H.
   unfold lnorm. simpl. now rewrite H.
 - destruct (of_lu d) eqn:Eq; [easy| ].
   rewrite to_ldec_tenfold; auto. rewrite IH.
   rewrite <- Eq in H. rewrite of_lu_0 in H.
   unfold lnorm. simpl. now destruct (nztail d).
Qed.
